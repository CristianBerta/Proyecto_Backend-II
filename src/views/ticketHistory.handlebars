<div class="container my-5">
    <h1 class="mb-4">Historial de Compras</h1>
    
    {{#if tickets.length}}
        <div class="row">
            {{#each tickets}}
                <div class="col-md-12 mb-3">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Ticket #{{code}}</h5>
                            <span class="badge {{#if (eq status 'completed')}}bg-success{{else if (eq status 'incomplete')}}bg-warning{{else}}bg-danger{{/if}}">
                                {{#if (eq status 'completed')}}Completada{{else if (eq status 'incomplete')}}Incompleta{{else}}Fallida{{/if}}
                            </span>
                        </div>
                        <div class="card-body">
                            <p><strong>Fecha:</strong> {{formatDate purchase_datetime}}</p>
                            <p><strong>Total:</strong> ${{amount}}</p>
                            <a href="/tickets/{{_id}}" class="btn btn-primary">Ver Detalles</a>
                        </div>
                    </div>
                </div>
            {{/each}}
        </div>
    {{else}}
        <div class="alert alert-info">
            No tienes compras realizadas todavía. 
            <a href="/" class="alert-link">¡Explora nuestros productos!</a>
        </div>
    {{/if}}
</div>