<div class="container my-5">
    <h1 class="mb-4">Administración de Tickets</h1>
    
    {{#if tickets.length}}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each tickets}}
                        <tr>
                            <td>{{code}}</td>
                            <td>{{formatDate purchase_datetime}}</td>
                            <td>{{purchaser}}</td>
                            <td>${{amount}}</td>
                            <td>
                                <span class="badge {{#if (eq status 'completed')}}bg-success{{else if (eq status 'incomplete')}}bg-warning{{else}}bg-danger{{/if}}">
                                    {{#if (eq status 'completed')}}Completada{{else if (eq status 'incomplete')}}Incompleta{{else}}Fallida{{/if}}
                                </span>
                            </td>
                            <td>
                                <a href="/tickets/{{_id}}" class="btn btn-sm btn-primary">Ver</a>
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    {{else}}
        <div class="alert alert-info">No hay tickets registrados en el sistema.</div>
    {{/if}}
</div>